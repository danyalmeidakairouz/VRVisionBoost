<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>VRVisionBoost</AssemblyName>
    <RootNamespace>VRVisionBoost</RootNamespace>
    <Version>1.0.2</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>disable</ImplicitUsings>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <!-- Path to your V Rising install. Override with: dotnet build -p:VRisingDir="D:\Games\VRising" -->
    <VRisingDir Condition="'$(VRisingDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\VRising</VRisingDir>
    <BepInExDir>$(VRisingDir)\BepInEx</BepInExDir>
    <CopyToPlugins Condition="'$(CopyToPlugins)' == ''">true</CopyToPlugins>
  </PropertyGroup>

  <!-- BepInEx 6 IL2CPP core assemblies (shipped with the BepInEx build you installed) -->
  <ItemGroup>
    <Reference Include="$(BepInExDir)\core\BepInEx.Core.dll" Private="false" />
    <Reference Include="$(BepInExDir)\core\BepInEx.Unity.IL2CPP.dll" Private="false" />
    <Reference Include="$(BepInExDir)\core\Il2CppInterop.Runtime.dll" Private="false" />
  </ItemGroup>

  <!-- Interop assemblies generated by BepInEx on the first game launch. -->
  <ItemGroup>
    <Reference Include="$(BepInExDir)\interop\Il2Cppmscorlib.dll" Private="false" />
    <!-- Il2CppSystem.Collections.Generic.HashSet, which is what
         CustomPostProcessVolumeComponent.instances hands back. -->
    <Reference Include="$(BepInExDir)\interop\Il2CppSystem.Core.dll" Private="false" />
    <Reference Include="$(BepInExDir)\interop\UnityEngine.dll" Private="false" />
    <Reference Include="$(BepInExDir)\interop\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="$(BepInExDir)\interop\Unity.Entities.dll" Private="false" />
    <Reference Include="$(BepInExDir)\interop\Unity.Transforms.dll" Private="false" />
    <Reference Include="$(BepInExDir)\interop\Unity.Mathematics.dll" Private="false" />
    <Reference Include="$(BepInExDir)\interop\Unity.Collections.dll" Private="false" />
    <!-- Vision, Hideable, PlayerCharacter, LocalCharacter -->
    <Reference Include="$(BepInExDir)\interop\ProjectM.Shared.dll" Private="false" />
    <!-- CheckOnScreen and the HideOutsideVision tag live here, not in ProjectM.Shared.
         Also BatFormFog, which is in the GLOBAL namespace despite living in this assembly. -->
    <Reference Include="$(BepInExDir)\interop\ProjectM.dll" Private="false" />
    <!-- HDRP. Needed only by BatFog.cs: BatFormFog derives from
         CustomPostProcessVolumeComponent (HighDefinition) -> VolumeComponent (Core), and the
         inherited `active` flag is what switches the effect off. -->
    <Reference Include="$(BepInExDir)\interop\Unity.RenderPipelines.Core.Runtime.dll" Private="false" />
    <Reference Include="$(BepInExDir)\interop\Unity.RenderPipelines.HighDefinition.Runtime.dll" Private="false" />
  </ItemGroup>

  <!-- Drop the DLL straight into BepInEx/plugins after a successful build -->
  <Target Name="CopyToBepInEx" AfterTargets="Build" Condition="'$(CopyToPlugins)' == 'true'">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(BepInExDir)\plugins" ContinueOnError="true" />
  </Target>

</Project>
